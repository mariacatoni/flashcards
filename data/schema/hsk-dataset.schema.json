{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hsk-dataset.schema.json",
  "title": "HSK flashcard dataset",
  "type": "object",
  "required": ["schemaVersion", "dataset", "partOfSpeechLabels", "entries"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "dataset": {
      "type": "object",
      "required": ["id", "syllabusVersion", "levels", "entryCount", "sources"],
      "properties": {
        "id": { "type": "string" },
        "syllabusVersion": { "const": "2025-11" },
        "levels": {
          "type": "array",
          "items": { "type": "integer", "minimum": 1, "maximum": 9 },
          "uniqueItems": true
        },
        "entryCount": { "type": "integer", "minimum": 1 },
        "sources": { "type": "array", "minItems": 2 }
      }
    },
    "partOfSpeechLabels": { "type": "object" },
    "entries": {
      "type": "array",
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "required": [
        "id", "sourceIndex", "level", "simplified", "characters", "pinyin",
        "partOfSpeech", "definitions", "quality"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^hsk3-2025-11-" },
        "sourceIndex": { "type": "integer", "minimum": 1 },
        "level": { "type": "integer", "minimum": 1, "maximum": 9 },
        "simplified": { "type": "string", "minLength": 1 },
        "senseNumber": { "type": ["integer", "null"], "minimum": 1 },
        "characters": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1, "maxLength": 1 }
        },
        "pinyin": {
          "type": "object",
          "required": ["display", "numbered", "readings"],
          "properties": {
            "display": { "type": "string", "minLength": 1 },
            "numbered": { "type": "string", "minLength": 2 },
            "cedictNumbered": { "type": ["string", "null"] },
            "readings": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["spelling", "tone"],
                  "properties": {
                    "spelling": { "type": "string", "minLength": 1 },
                    "tone": { "type": "integer", "minimum": 1, "maximum": 5 }
                  }
                }
              }
            }
          }
        },
        "partOfSpeech": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "definitions": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "quality": {
          "type": "object",
          "required": ["pinyinMatchesCedict", "definitionNeedsReview"],
          "properties": {
            "pinyinMatchesCedict": { "type": "boolean" },
            "definitionNeedsReview": { "type": "boolean" }
          }
        }
      }
    }
  }
}
